+        assert_eq!(contract["required"], json!(["name"]));
+        assert_eq!(contract["additionalProperties"], false);
+        assert!(contract["properties"].get("new_name").is_none());
+        assert!(contract["properties"]["appearance_anchor"].get("maxLength").is_none());
+        for field in ["known_as", "gender", "age", "role", "location", "outfit"] {
+            assert_eq!(contract["properties"][field]["maxLength"], 200);
+            assert_eq!(contract["properties"][field]["type"], json!(["string", "null"]));
+            let mut args = json!({"name":"Mira","stats":[{"attribute":"Unregistered character stat","delta":1,"reason":"x"}]});
+            args[field] = json!("x".repeat(201));
+            let error = save.execute(args).await.unwrap_err().to_string();
+            assert!(error.contains(field));
+            assert!(!error.contains("embedding API key"));
+        }
+        for args in [
+            json!(false), json!({"name":null}), json!({"name":" "}),
+            json!({"name":"Mira -> Varro"}), json!({"name":"Mira","role":false}),
+            json!({"name":"Mira","appearance_anchor":7}),
+            json!({"name":"Mira","new_name":"Varro"}), json!({"name":"Mira","unknown":true}),
+        ] {
+            assert!(save.execute(args).await.is_err());
+        }
+        let error = save.execute(json!({"name":"Mira","stats":[
+            {"attribute":"Stealth","delta":1,"reason":"first"},
+            {"attribute":"Stealth","delta":"bad","reason":"second"}]})).await.unwrap_err();
+        assert!(error.to_string().contains("stats[1]"));
+        let change = json!({"attribute":"Stealth","delta":1,"reason":"x"});
+        assert!(save.execute(json!({"name":"Mira","stats":vec![change; 9]})).await.is_err());
+        turn.with(|conn| {
+            assert!(entities::list_entities_sync(conn, turn.story_id(), Some(CHARACTER))?.is_empty());
+            Ok(())
+        }).await.unwrap();
+        let long_anchor = "x".repeat(400);
+        let unicode_role = "\u{00e9}".repeat(200);
+        save.execute(json!({"name":"Mira","appearance_anchor":long_anchor,"role":unicode_role})).await.unwrap();
+        let accepted = character(&turn, "Mira").await.character;
+        assert_eq!(accepted.appearance_anchor, Some(long_anchor));
+        assert_eq!(accepted.role, Some(unicode_role));
+        turn.rollback().await.unwrap();
+    }
