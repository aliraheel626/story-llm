+use std::sync::Arc;
+
+use rig_agent::tool::{PortableDynamicTool, ToolOutput};
+use serde_json::{json, Value};
+
+use crate::features::entities::{
+    self,
+    model::{CharacterFields, CharacterPatch, CHARACTER},
+    repository,
+};
+use crate::features::narrator::catalog::{self, ToolAvailability, ToolDeps, ToolSpec};
+use crate::features::turn::TurnTx;
+
+use super::shared::{
+    apply_resolved_stats, nullable_field, object_args, parse_stats, required_string,
+    resolve_stats, stats_schema,
+};
+use super::to_tool_error;
+
+pub const NAME: &str = "save_character";
+pub const DESCRIPTION: &str =
+    "Record a character the story has established, or update one. Always use the character's \
+     true name, decided when you introduce them, even if the player doesn't know it yet; put \
+     how the player knows them in known_as and narrate them only that way until revealed. Keep \
+     location and outfit current as the story moves. Fields you leave out stay as they are; \
+     null clears a field. Use stats for changes such as an injury; most changes are minor, and \
+     dramatic is only for a major, story-changing swing. Only set facts the story has \
+     established or that you have decided for a character you're introducing.";
+pub const INSTRUCTION: &str = "Use save_character for new or changed characters, including where they are and what they wear.";
+
+pub fn schema() -> Value {
+    json!({
+        "type": "object",
+        "properties": {
+            "name": {"type": "string", "description": "The character's true name, even if the player doesn't know it yet. An existing name updates that character."},
+            "known_as": {"type": ["string", "null"], "maxLength": 200, "description": "How the player currently knows them when they don't know the name, e.g. 'the hooded stranger'. Set null when the name is revealed."},
+            "appearance_anchor": {"type": ["string", "null"], "description": "Stable look for images: face, hair, build, signature features."},
+            "gender": {"type": ["string", "null"], "maxLength": 200, "description": "Gender, e.g. female, male, or nonbinary."},
+            "age": {"type": ["string", "null"], "maxLength": 200, "description": "Age, e.g. 34, elderly, or young adult."},
+            "role": {"type": ["string", "null"], "maxLength": 200, "description": "Role in the story, e.g. innkeeper or smuggler."},
+            "location": {"type": ["string", "null"], "maxLength": 200, "description": "Where they are now, in a few words, e.g. 'the Rusty Anchor, back room'. Update it when they move."},
+            "outfit": {"type": ["string", "null"], "maxLength": 200, "description": "What they're wearing now. Update it when it changes."},
+            "stats": stats_schema()
+        },
+        "required": ["name"],
+        "additionalProperties": false
+    })
+}
+
+fn label(args: &Value) -> String {
+    let name = args.get("name").and_then(Value::as_str).map(str::trim)
+        .filter(|name| !name.is_empty()).unwrap_or("a character");
+    format!("Recording {name}…")
+}
+
+fn enabled(availability: &ToolAvailability<'_>) -> bool {
+    catalog::normal_mode(availability) && availability.settings.save_character
+}
+
+fn build(deps: &ToolDeps) -> PortableDynamicTool {
+    let (turn, target, turn_id) = catalog::turn(deps);
+    tool(turn, target, turn_id, deps.embedding_api_key.clone())
+}
+
+pub const SPEC: ToolSpec = ToolSpec {
+    name: NAME,
+    instruction: Some(INSTRUCTION),
+    needs_turn: true,
+    enabled,
+    build,
+    label,
+};
+
+pub(super) fn tool(
+    turn: Arc<TurnTx>,
+    target_entry_id: String,
+    turn_id: String,
+    embedding_api_key: String,
+) -> PortableDynamicTool {
+    PortableDynamicTool::new(NAME, DESCRIPTION, schema(), move |args: Value| {
+        let turn = turn.clone();
+        let target_entry_id = target_entry_id.clone();
+        let turn_id = turn_id.clone();
+        let embedding_api_key = embedding_api_key.clone();
+        Box::pin(async move {
+            let fields = object_args(&args,
+                &["name", "known_as", "appearance_anchor", "gender", "age", "role", "location", "outfit", "stats"], NAME)
+                .map_err(to_tool_error)?;
+            let name = required_string(fields, "name").map_err(to_tool_error)?;
+            repository::validated_name(&name).map_err(to_tool_error)?;
+            let patch = CharacterPatch {
+                known_as: nullable_field(fields, "known_as").map_err(to_tool_error)?,
+                appearance_anchor: nullable_field(fields, "appearance_anchor").map_err(to_tool_error)?,
+                gender: nullable_field(fields, "gender").map_err(to_tool_error)?,
+                age: nullable_field(fields, "age").map_err(to_tool_error)?,
+                role: nullable_field(fields, "role").map_err(to_tool_error)?,
+                location: nullable_field(fields, "location").map_err(to_tool_error)?,
+                outfit: nullable_field(fields, "outfit").map_err(to_tool_error)?,
+            }.normalize().map_err(to_tool_error)?;
+            let stats = parse_stats(fields.get("stats")).map_err(to_tool_error)?;
+            let name = turn.with(|conn| {
+                Ok(entities::list_entities_sync(conn, turn.story_id(), Some(CHARACTER))?
+                    .into_iter().find(|entity| entity.name.eq_ignore_ascii_case(&name))
+                    .map_or_else(|| name.clone(), |entity| entity.name))
+            }).await.map_err(to_tool_error)?;
+            let resolved = resolve_stats(&turn, &embedding_api_key, CHARACTER, stats.as_deref().unwrap_or_default())
+                .await.map_err(to_tool_error)?;
+            let (entity, created, results) = turn.with_savepoint(|conn| {
+                let existing = entities::list_entities_sync(conn, turn.story_id(), Some(CHARACTER))?
+                    .into_iter().find(|entity| entity.name.eq_ignore_ascii_case(&name));
+                let (entity, created) = if let Some(existing) = existing {
+                    (repository::update_character_sync(conn, turn.story_id(), &existing.id, None,
+                        &patch, "narrator_tool", Some(&target_entry_id), Some(&turn_id))?, false)
+                } else {
+                    (repository::create_character_sync(conn, turn.story_id(), &name,
+                        patch.apply_to(&CharacterFields::default()), "narrator_tool", Some(&target_entry_id), Some(&turn_id))?, true)
+                };
+                let results = apply_resolved_stats(conn, turn.story_id(), &entity.id, resolved, &target_entry_id, &turn_id)?;
+                Ok((entity, created, results))
+            }).await.map_err(to_tool_error)?;
+            let mut output = json!({"name": entity.name, "kind": entity.kind, "created": created});
+            if stats.is_some() {
+                output["stats"] = json!(results);
+            }
+            Ok(ToolOutput::json(output))
+        })
+    })
+}
