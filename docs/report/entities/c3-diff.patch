+                    "endpoint {id} must be a present character in this story"
+                ))
+            })
+    };
+    let from = endpoint(&link.from_id)?;
+    let to = endpoint(&link.to_id)?;
+    let conflicting_id: Option<String> = conn
+        .query_row(
